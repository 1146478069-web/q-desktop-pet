{
  "name": "q-desktop-pet",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main/main/main.js",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js --host 127.0.0.1",
    "dev:electron": "node node_modules/npm-run-all/bin/npm-run-all/index.js -p dev electron:watch",
    "electron:watch": "node node_modules/typescript/bin/tsc -p tsconfig.node.json --watch --preserveWatchOutput",
    "electron:start": "node node_modules/electron/cli.js .",
    "build": "node node_modules/typescript/bin/tsc -p tsconfig.node.json && node scripts/build-standalone-renderer.cjs",
    "test": "node node_modules/vitest/vitest.mjs run --config vitest.config.mjs",
    "test:watch": "node node_modules/vitest/vitest.mjs --config vitest.config.mjs",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit && node node_modules/typescript/bin/tsc -p tsconfig.node.json --noEmit"
  },
  "dependencies": {
    "@types/pngjs": "^6.0.5",
    "electron": "^30.0.0",
    "pngjs": "^7.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "@vitejs/plugin-react": "^4.2.1",
    "jsdom": "^24.0.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.4.5",
    "vite": "^5.2.9",
    "vitest": "^1.5.0"
  }
}
